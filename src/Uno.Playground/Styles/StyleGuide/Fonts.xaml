<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Uno.Fonts.OpenSans is referenced implicitly by the Uno.Sdk (UnoDefaultFont) -->
	<FontFamily x:Key="FontFamily01">ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Regular.ttf#Open Sans</FontFamily>
	<FontFamily x:Key="FontFamily01Light">ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Light.ttf#Open Sans</FontFamily>
	<FontFamily x:Key="FontFamily01Semibold">ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-SemiBold.ttf#Open Sans</FontFamily>
	<FontFamily x:Key="FontFamily01Bold">ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf#Open Sans</FontFamily>
	<FontFamily x:Key="FontFamily01ExtraBold">ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-ExtraBold.ttf#Open Sans</FontFamily>
</ResourceDictionary>
